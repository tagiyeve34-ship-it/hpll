<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:id="@+id/bubble" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="7dp" android:paddingBottom="5dp" android:maxWidth="310dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <TextView android:id="@+id/text" android:textColor="#E9EDEF" android:textSize="16sp" android:lineSpacingExtra="1dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/meta" android:textColor="#AEBAC1" android:textSize="10sp" android:layout_gravity="end" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
